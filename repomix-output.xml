.messages-layout { display:grid;grid-template-columns:245px minmax(0,1fr) 220px;min-height:570px;overflow:hidden; }.inbox-column,.chat-column,.chat-details { min-width:0; }.inbox-column { border-right:1px solid var(--line); }.inbox-heading { display:flex;align-items:center;justify-content:space-between;padding:19px 17px 15px; }.inbox-heading h2 { margin:0;font:700 15px "Plus Jakarta Sans"; }.inbox-heading button { width:25px;height:25px;color:#fff;background:var(--indigo);border-radius:7px; }.conversation { display:flex;gap:9px;align-items:center;padding:12px 15px;border-left:3px solid transparent; }.conversation:hover { background:#fafaff; }.conversation.active { border-left-color:var(--indigo);background:#f2f1ff; }.conversation-body { min-width:0;flex:1; }.conversation-name { display:flex;justify-content:space-between;gap:5px; }.conversation-name b { overflow:hidden;font-size:11px;white-space:nowrap;text-overflow:ellipsis; }.conversation-name span { color:#a2a2b0;font-size:9px; }.conversation-body p { margin:4px 0 0;overflow:hidden;color:#858699;white-space:nowrap;text-overflow:ellipsis;font-size:10px; }.unread { display:grid;width:16px;height:16px;place-items:center;color:#fff;background:var(--indigo);border-radius:50%;font-size:9px; }.chat-header { display:flex;align-items:center;justify-content:space-between;padding:17px 20px;border-bottom:1px solid var(--line); }.chat-person { display:flex;gap:9px;align-items:center; }.chat-person h3 { margin:0;font-size:12px; }.online-status { margin-top:3px;color:#32a98f;font-size:10px; }.chat-actions { display:flex;gap:7px; }.chat-actions button { width:29px;height:29px;color:#666882;background:#f5f5f9;border-radius:7px; }.chat-thread { display:flex;min-height:406px;flex-direction:column;justify-content:flex-end;gap:13px;padding:21px;background:linear-gradient(160deg,#fff,#fdfdff); }.message { display:flex;gap:8px;align-items:end;max-width:78%; }.message.mine { align-self:end;flex-direction:row-reverse; }.bubble { padding:10px 12px;color:#5e5f75;background:#f0f0f7;border-radius:11px 11px 11px 3px;font-size:11px;line-height:1.42; }.mine .bubble { color:#fff;background:var(--indigo);border-radius:11px 11px 3px 11px; }.message-time { display:block;margin-top:4px;color:#9c9cad;font-size:9px; }.mine .message-time { text-align:right; }.chat-composer { display:flex;gap:8px;padding:15px 19px;border-top:1px solid var(--line); }.chat-composer button { width:32px;color:#73748b;background:#f4f4f8;border-radius:8px; }.chat-composer input { flex:1;min-width:0;padding:10px;border:0;outline:0;color:var(--ink); }.chat-composer .send-message { color:#fff;background:var(--indigo); }.chat-details { padding:20px 15px;border-left:1px solid var(--line);text-align:center; }.chat-details .avatar { width:54px;height:54px;margin-top:6px;font-size:14px; }.chat-details h3 { margin:10px 0 3px;font:700 13px "Plus Jakarta Sans"; }.chat-details p { margin:0;color:#8d8e9f;font-size:10px; }.detail-divider { height:1px;margin:19px 0;background:var(--line); }.detail-section { text-align:left; }.detail-section h4 { margin:0 0 11px;font-size:11px; }.shared-file { display:flex;gap:7px;align-items:center;padding:7px 0;color:#74758d;font-size:10px; }.file-type { display:grid;width:26px;height:26px;place-items:center;color:#e15e72;background:#fff0f2;border-radius:6px;font-size:8px;font-weight:700; }

