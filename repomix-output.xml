    },

    // Frontend hiện tại không gửi grade riêng.
    grade: {
      type: String,
      default: '',
      trim: true,
    },

    budget: {
      type: Number,
      required: true,
      min: 0,
    },

    description: {
      type: String,
      default: '',
    },

    preferredTime: {
      type: String,
      default: '',
    },

    status: {
      type: String,
      enum: ['open', 'matched', 'cancelled'],
      default: 'open',
    },
  },
  {
    timestamps: true,
  }
);

const appointmentSchema = new mongoose.Schema(
  {
    studentId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: 'User',
      required: true,
    },

    tutorId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: 'User',
      required: true,
    },

    subject: {
      type: String,
      required: true,
      trim: true,
    },

    startTime: {
      type: Date,
      required: true,
    },

    endTime: {
      type: Date,
      required: true,
    },

    notes: {
      type: String,
      default: '',
    },

    hourlyRate: {
      type: Number,
      required: true,
      min: 0,
    },

    totalAmount: {
      type: Number,
      required: true,
      min: 0,
    },

    status: {
      type: String,
      enum: ['pending', 'confirmed', 'completed', 'cancelled'],
      default: 'pending',
    },
  },
  {
    timestamps: true,
  }
);

const messageSchema = new mongoose.Schema(
  {
    senderId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: 'User',
