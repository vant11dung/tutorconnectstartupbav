  });
}
```

**Sau (API Call):**
```javascript
async function createAppointment(tutorId, subject, dateTime, duration) {
  try {
    const appointment = await apiCall('/appointments', {
      method: 'POST',
      body: JSON.stringify({
        tutorId,
        subject,
        dateTime,
        duration,
      }),
    });
    state.appointments.push(appointment);
    renderUI();
  } catch (error) {
    alert('Lỗi: ' + error.message);
  }
}
```

