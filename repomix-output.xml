  }
);


/* =========================================================
   BOOTSTRAP
========================================================= */

async function bootstrap() {
  loadCurrentUser();

  const token =
    getToken();

  /*
   * Không có token:
   * -> bắt buộc login thật.
   */
  if (
    !token ||
    !state.currentUser
  ) {
    showAuthScreen(
      true
    );

    renderNav();
    renderAllViews();

    return;
  }


  /*
   * Có token:
   * -> dùng user lưu trong localStorage,
   * -> gọi API protected.
   */
  state.role =
    state.currentUser.role ||
    'student';

  showAuthScreen(
    false
  );

  applyIdentity();

  renderNav();

  await fetchViewData();

  renderAllViews();

  navigateWithoutFetch(
    'dashboard'
  );
}

bootstrap();


