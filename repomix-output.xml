      type: String,
      required: true,
      select: false,
    },

    role: {
      type: String,
      enum: ['student', 'tutor', 'admin'],
      default: 'student',
    },

    avatar: {
      type: String,
      default: '',
    },

    bio: {
      type: String,
      default: '',
    },

    subjects: [
      {
        type: String,
      },
    ],

    hourlyRate: {
      type: Number,
      default: 0,
      min: 0,
    },

    location: {
      type: String,
      default: '',
    },

    verified: {
      type: Boolean,
      default: false,
    },
  },
  {
    timestamps: true,
  }
);

const tutorRequestSchema = new mongoose.Schema(
  {
    studentId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: 'User',
