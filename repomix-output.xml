.modal-backdrop { position:fixed;z-index:20;inset:0;display:grid;place-items:center;padding:20px;background:rgba(26,27,60,.48);opacity:0;visibility:hidden;transition:.2s ease; }.modal-backdrop.open { opacity:1;visibility:visible; }.modal { position:relative;width:min(460px,100%);max-height:calc(100vh - 40px);overflow:auto;padding:28px;background:#fff;border-radius:16px;box-shadow:0 24px 58px rgba(16,17,52,.28);transform:translateY(9px) scale(.98);transition:.2s ease; }.modal-backdrop.open .modal { transform:none; }.close-modal { position:absolute;top:12px;right:14px;width:27px;height:27px;color:#77788d;background:#f2f2f6;border-radius:7px;font-size:19px;line-height:1; }.modal h2 { margin:0;font:800 20px "Plus Jakarta Sans";letter-spacing:-.6px; }.modal > div > p { margin:8px 0 21px;color:#7e7f92;font-size:12px;line-height:1.5; }.form-group { margin-top:14px; }.form-group label { display:block;margin-bottom:6px;color:#5f6077;font-size:11px;font-weight:700; }.form-group input,.form-group select,.form-group textarea { width:100%;padding:11px 12px;color:var(--ink);border:1px solid #dedee8;border-radius:8px;outline:none;background:#fff; }.form-group textarea { min-height:76px;resize:vertical; }.form-group input:focus,.form-group select:focus,.form-group textarea:focus { border-color:#8585ed;box-shadow:0 0 0 3px rgba(91,92,226,.11); }.upload-drop { display:grid;min-height:103px;place-items:center;align-content:center;margin-top:7px;border:1.5px dashed #bdbdeb;border-radius:10px;color:#7576a2;background:#fafaff;text-align:center; }.upload-drop b { margin-top:6px;font-size:11px; }.upload-drop span { margin-top:4px;color:#999ab0;font-size:10px; }.modal-actions { display:flex;justify-content:flex-end;gap:8px;margin-top:23px; }.modal-actions button { padding:10px 13px;border-radius:8px;font-size:11px;font-weight:700; }.cancel-button { color:#707187;background:#f1f1f6; }.confirmation-icon { display:grid;width:50px;height:50px;place-items:center;margin:0 auto 14px;color:#178e73;background:#e7faf3;border-radius:50%;font-size:24px;font-weight:800; }.confirmation { text-align:center; }.confirmation h2 { text-align:center; }.confirmation p { margin-bottom:0 !important; }
