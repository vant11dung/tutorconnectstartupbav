function parseGrade(subject) {
  const match =
    String(subject || '')
      .match(
        /(?:lớp|khối)\s*(\d{1,2})/i
      );

  return match
    ? match[1]
    : '';
}

function toIsoFromDateTimeLocal(
  value
) {
  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    throw new Error(
      'Thời gian không hợp lệ.'
    );
  }

  return date.toISOString();
}

