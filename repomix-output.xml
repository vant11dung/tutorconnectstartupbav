.admin-metrics { display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px; }.admin-metric { padding:18px; }.admin-metric p { margin:0;color:#88899c;font-size:11px; }.admin-metric h2 { margin:8px 0 0;font:800 23px "Plus Jakarta Sans";letter-spacing:-.7px; }.admin-metric small { display:block;margin-top:8px;color:#36a38e;font-size:10px; }.admin-metric:nth-child(2) small { color:#e38b3d; }.admin-metric:nth-child(3) small { color:#6870a0; }.admin-metric:nth-child(4) small { color:#6571e4; }.admin-grid { display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.8fr);gap:20px; }.admin-table-card { overflow:hidden; }.table-heading { display:flex;align-items:center;justify-content:space-between;padding:20px; }.table-heading h2 { margin:0;font:700 15px "Plus Jakarta Sans"; }.table-heading button { color:var(--indigo);background:none;font-weight:700;font-size:11px; }.review-table { width:100%;border-collapse:collapse; }.review-table th { padding:9px 20px;color:#9b9cad;background:#fafafe;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-align:left;font-size:9px;letter-spacing:.4px; }.review-table td { padding:13px 20px;border-bottom:1px solid #f0f0f5;font-size:11px; }.review-table tr:last-child td { border:0; }.table-person { display:flex;align-items:center;gap:8px; }.table-person b { display:block;font-size:11px; }.table-person span { display:block;margin-top:2px;color:#9596a6;font-size:9px; }.subject-pill,.status-pill { display:inline-block;padding:4px 7px;border-radius:5px;color:#5d5e79;background:#f1f1f6;font-size:9px;font-weight:700; }.status-pill.waiting { color:#a66c0f;background:#fff5df; }.status-pill.verified { color:#168670;background:#e5f8f2; }.table-action { padding:6px 8px;color:#fff;background:var(--indigo);border-radius:6px;font-size:9px;font-weight:700; }.revenue-card { padding:20px; }.revenue-card h2 { margin:0;font:700 15px "Plus Jakarta Sans"; }.chart-head { display:flex;align-items:end;justify-content:space