    title: 'Không gian quản trị',
    person: 'Nguyễn Hoàng',
    initials: 'NH',
    avatar: 'avatar-admin',
    nav: [
      ['dashboard', '⌂', 'Tổng quan'],
      ['admin-review', '✓', 'Duyệt gia sư', '7'],
