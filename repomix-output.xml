/* ============================================================
   DEMO SECTION STYLING
   
   Thêm đoạn CSS này vào cuối file styles.css
============================================================ */

.demo-section {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border, #e5e7eb);
}

.demo-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--color-text-secondary, #6b7280);
  margin-bottom: 0.75rem;
  letter-spacing: 0.5px;
}

.demo-buttons {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}

.demo-btn {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: 0.5rem;
  background: transparent;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: left;
  font-size: 0.875rem;
  font-family: inherit;
}

.demo-btn:hover {
  border-color: var(--color-primary, #20214f);
  background: rgba(32, 33, 79, 0.02);
  transform: translateX(2px);
}

.demo-btn:active {
  transform: translateX(0px);
}

.demo-btn span {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.demo-btn strong {
  display: block;
  color: var(--color-text-primary, #1f2937);
  margin-bottom: 0.2rem;
  font-weight: 600;
}

.demo-btn small {
  display: block;
  color: var(--color-text-secondary, #6b7280);
  font-size: 0.75rem;
  font-weight: 400;
}

/* Màu hover cho từng role */

.demo-btn.demo-student:hover {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.02);
}

.demo-btn.demo-tutor:hover {
  border-color: #10b981;
  background: rgba(16, 185, 129, 0.02);
}

.demo-btn.demo-admin:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.02);
}

/* Responsive */

@media (max-width: 768px) {
  .demo-btn {
    padding: 0.7rem 0.9rem;
    font-size: 0.8rem;
  }

  .demo-btn span {
    font-size: 1.25rem;
  }
}

@media (max-width: 480px) {
  .demo-section {
    margin-top: 1.5rem;
    padding-top: 1rem;
  }

  .demo-buttons {
    gap: 0.5rem;
  }

  .demo-btn {
    padding: 0.6rem 0.8rem;
  }
}

/* ============================================================
   DARK MODE SUPPORT (tùy chọn)
============================================================ */

@media (prefers-color-scheme: dark) {
  .demo-section {
    border-top-color: #374151;
  }

  .demo-btn {
    border-color: #374151;
  }

  .demo-btn:hover {
    background: rgba(32, 33, 79, 0.1);
  }

  .demo-btn strong {
    color: #f3f4f6;
  }

  .demo-btn small {
    color: #9ca3af;
  }

  .demo-btn.demo-student:hover {
    background: rgba(59, 130, 246, 0.1);
  }

  .demo-btn.demo-tutor:hover {
    background: rgba(16, 185, 129, 0.1);
  }

  .demo-btn.demo-admin:hover {
    background: rgba(245, 158, 11, 0.1);
  }
}
/* Đồng bộ font chữ tránh lỗi phông */
.auth-form h2, .auth-copy h1 {
  font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif !important;
}

.auth-form, .auth-form input, .auth-form select, .auth-form label, .demo-roles button {
  font-family: "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif !important;
}

/* Khung ghi chú demo */
.demo-notice {
  background: #f0efff;
  border: 1px solid #d6d3ff;
  border-radius: 9px;
  padding: 10px 12px;
  margin: 10px 0 14px;
}

.demo-notice p {
  margin: 0;
  color: #4849a6;
  font-size: 11px;
  line-height: 1.5;
}

.demo-notice b {
  color: #38399d;
}

/* Nút đăng xuất */
.logout-btn {
  color: #ff8a98 !important;
  margin-top: 2px;
}

.logout-btn:hover {
  background: rgba(255, 124, 140, 0.12) !important;
  color: #ff6e7f !important;
}
